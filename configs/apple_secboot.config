# UEFI Secure Boot for Apple silicon (docs/secure-boot.md in aura):
#   make apple_m1_defconfig apple_secboot.config
#   scripts/config --set-str EFI_VAR_SEED_FILE /abs/path/ubootefi.var
# PK, KEK, db and dbx come only from the seed built into this binary, which
# the signed aura Stage 2 carries; nothing on the ESP can change them.
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_EFI_SECURE_BOOT=y
CONFIG_EFI_VARIABLES_PRESEED=y
CONFIG_EFI_VAR_SEED_FILE="ubootefi.var"
CONFIG_EFI_AURORA_MEASURE=y
# Only signed EFI images may run: no raw kernel, extlinux, script or VBE
# boots, which UEFI Secure Boot does not cover. No prompt: autoboot cannot
# be interrupted, and when no signed OS boots the machine resets instead of
# leaving a shell where booti/load would bypass the signature checks.
CONFIG_BOOTDELAY=-2
CONFIG_BOOTCOMMAND="bootflow scan -b; echo Secure Boot: no signed OS found, resetting; sleep 10; reset"
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_BOOTMETH_DISTRO is not set
# CONFIG_BOOTMETH_EXTLINUX is not set
# CONFIG_BOOTMETH_EXTLINUX_PXE is not set
# CONFIG_BOOTMETH_SCRIPT is not set
# CONFIG_BOOTMETH_VBE is not set
CONFIG_BOOTMETH_EFILOADER=y
CONFIG_BOOTMETH_EFI_BOOTMGR=y
