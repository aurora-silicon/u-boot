# UEFI Secure Boot for Apple silicon (docs/secure-boot.md in aura):
#   make apple_m1_defconfig apple_secboot.config
#   scripts/config --set-str EFI_VAR_SEED_FILE /abs/path/ubootefi.var
# PK, KEK, db and dbx come only from the seed built into this binary, which
# the signed aura Stage 2 carries; nothing on the ESP can change them. Build
# the seed with tools/apple_secboot_seed.py from the distribution's keys (the
# default) or from keys the machine owner generated; it refuses Microsoft's
# UEFI CAs, so only images signed by the seeded db keys verify.
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_EFI_SECURE_BOOT=y
CONFIG_EFI_VARIABLES_PRESEED=y
CONFIG_EFI_VAR_SEED_FILE="ubootefi.var"
CONFIG_EFI_AURORA_MEASURE=y
# Audit by default: every image is checked against db/dbx and the verdict
# recorded, and an image that fails still starts (SecureBoot reads 0). To
# enforce, add:
#   # CONFIG_EFI_AURORA_SECBOOT_AUDIT is not set
CONFIG_EFI_AURORA_SECBOOT_AUDIT=y
# Only signed EFI images (a UKI, or systemd-boot and UKIs) are booted: no raw
# kernel, extlinux, script or VBE boots, which UEFI Secure Boot does not
# cover. No prompt: autoboot cannot be interrupted, and when no OS boots the
# machine resets instead of leaving a shell where booti/load would bypass
# the signature checks.
CONFIG_BOOTDELAY=-2
CONFIG_BOOTCOMMAND="bootflow scan -b; echo Secure Boot: no signed OS found, resetting; sleep 10; reset"
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_BOOTMETH_DISTRO is not set
# CONFIG_BOOTMETH_EXTLINUX is not set
# CONFIG_BOOTMETH_EXTLINUX_PXE is not set
# CONFIG_BOOTMETH_SCRIPT is not set
# CONFIG_BOOTMETH_VBE is not set
CONFIG_BOOTMETH_EFILOADER=y
CONFIG_BOOTMETH_EFI_BOOTMGR=y
